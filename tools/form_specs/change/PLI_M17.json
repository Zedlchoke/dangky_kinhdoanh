{
  "form_id": "PLI_M17",
  "group": "change",
  "note": "Giay de nghi dang ky hoat dong chi nhanh/VPDD/thong bao lap dia diem KD. Luoi nganh o muc '3a' mat khi convert; muc sau la '3b) Noi dung hoat dong'.",
  "gap_nghiepvu": null,
  "tables": [
    {
      "spec": {
        "id": "ds_nganh",
        "detect": ["stt", "ten nganh", "ma nganh"],
        "stt_tag": true,
        "cols": [
          ["^stt$", null],
          ["ten nganh", "ten_nganh"],
          ["ma nganh", "ma_nganh"],
          ["^nganh chinh$|nganh, nghe kinh doanh chinh", "la_nganh_chinh"]
        ],
        "loop": "ds_nganh",
        "fields": ["ten_nganh", "ma_nganh", "la_nganh_chinh"]
      },
      "pos": "after",
      "anchor": "^a\\) nganh, nghe kinh doanh",
      "no_default_drops": true,
      "drop_until": "^b\\) noi dung hoat dong",
      "drop": ["^stt$", "^ten nganh\\b", "^ma nganh\\d*$",
               "^nganh, nghe kinh doanh chinh"],
      "headers": ["STT", "Tên ngành", "Mã ngành", "Ngành, nghề kinh doanh chính"]
    }
  ]
}
